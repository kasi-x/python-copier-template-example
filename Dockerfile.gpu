# GPU-enabled developer container (nvidia-docker / CUDA).
# Build and run with:
#   docker build --target developer -f Dockerfile.gpu -t python-copier-template-example:gpu .
#   docker run --gpus all -it python-copier-template-example:gpu
FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu22.04 AS developer

# Install system dependencies
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git \
    curl \
    && apt-get dist-clean

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
# Change the working directory to the `app` directory
WORKDIR /app

# Copy the lockfile and pyproject in first for better layer caching
COPY pyproject.toml ./
COPY uv.lock ./# Install dependencies

RUN uv sync --locked --no-install-project
# Copy the rest of the project
COPY . .

# Default to bash
CMD ["/bin/bash"]
